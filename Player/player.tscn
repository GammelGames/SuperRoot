[sub_resource type="GDScript" id="GDScript_l8h54"]
script/source = "extends CharacterBody2D

const START_JUMPS = 2
const WALKING_SPEED = 180
const RUNNING_SPEED = 250.0
const GROUND_ACCELERATION = 30
const AIR_ACCELERATION = 25
const JUMP_VELOCITY = -350.0
var speed = WALKING_SPEED
var jump_count = START_JUMPS
var was_on_floor = false
var just_jumped = false


@onready var jump_sound: AudioStreamPlayer2D = $JumpSound
@onready var coyote_time: Timer = $CoyoteTime
@onready var jump_buffer: Timer = $JumpBuffer
@onready var jump_indicator: AnimatedSprite2D = $\"../FollowerNode/JumpIndicator\"






# Erhöht Jump count beim einsammeln von Gold
func collect_gold():
	jump_count += 1
	if jump_buffer.time_left > 0: # Jump buffer eingebaut
			jump()
	

func jump():
	velocity.y = JUMP_VELOCITY
	jump_sound.play()
	jump_count -= 1
	just_jumped = true


func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"jump\") and jump_count > 0:
		jump()
	if Input.is_action_just_released(\"jump\") and velocity.y < 0:
		velocity.y *= 0.4
	
		
		# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"move_left\", \"move_right\")
	if direction:
		var acceleration = GROUND_ACCELERATION
		
		if not is_on_floor():
			acceleration = AIR_ACCELERATION
		
		velocity.x = move_toward(velocity.x, direction * speed, acceleration)
		
	else:
		velocity.x = move_toward(velocity.x, 0, GROUND_ACCELERATION*2)
	
	if velocity.x != 0 and is_on_floor():
		$AnimatedSprite2D.play(\"Root Running\")
	else: $AnimatedSprite2D.play(\"Root Idle\")
	
	
	# Jump Animation
	if not is_on_floor():
		$AnimatedSprite2D.play(\"Root Jump\")
		remap(velocity.y, -350, 350, 0, 7)
		
	if velocity.x > 0:
		$AnimatedSprite2D.flip_h = false
	elif velocity.x < 0:
		$AnimatedSprite2D.flip_h = true
	

	move_and_slide()
	
	# von Platform laufen
	if was_on_floor and not is_on_floor() and not just_jumped:
		coyote_time.start()
		
	
	# Jump reset.
	if is_on_floor() and not was_on_floor:
		jump_count = START_JUMPS
		if jump_buffer.time_left > 0: # Jump buffer eingebaut
			jump()
	if is_on_floor() and jump_count > 2:
		jump_count = START_JUMPS
			
		
	# Jump Buffer
	if not is_on_floor() and Input.is_action_just_pressed(\"jump\"):
		if jump_count==0:
			jump_buffer.start()
		
		
		# Handle running
	if Input.is_action_pressed(\"run\") and is_on_floor():
		speed = RUNNING_SPEED
		$AnimatedSprite2D.speed_scale = 1.5
	if Input.is_action_just_released(\"run\") and is_on_floor():
		speed = WALKING_SPEED
		$AnimatedSprite2D.speed_scale = 1
	if is_on_floor() and not was_on_floor and not Input.is_action_pressed(\"run\"):
		speed = WALKING_SPEED
		$AnimatedSprite2D.speed_scale = 1
		
	was_on_floor = is_on_floor()
	
	just_jumped = false
		
		
	jump_indicator.frame = jump_count # Jump Indicator ändert sich je nach Anzahl der jumps

func _on_coyote_time_timeout() -> void:
	if not is_on_floor():
		jump_count = 1
	else: jump_count = 2
"

